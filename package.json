{
  "name": "iobroker.victoriametrics",
  "version": "0.6.0",
  "description": "Schreibt ioBroker-Datenpunkt-Historie nativ in VictoriaMetrics",
  "author": {
    "name": "SeaSpotter",
    "email": "seatowage@gmail.com"
  },
  "contributors": [],
  "homepage": "https://github.com/seaspotter/ioBroker.victoriametrics",
  "license": "MIT",
  "keywords": [
    "victoriametrics",
    "history",
    "prometheus",
    "monitoring",
    "timeseries",
    "ioBroker"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/seaspotter/ioBroker.victoriametrics.git"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@iobroker/adapter-core": "^3.4.3",
    "@iobroker/aggregate": "^1.0.3",
    "@iobroker/plugin-docker": "^1.3.1",
    "axios": "^1.20.0"
  },
  "devDependencies": {
    "@alcalzone/release-script": "^5.2.1",
    "@alcalzone/release-script-plugin-iobroker": "^5.2.0",
    "@alcalzone/release-script-plugin-license": "^5.2.2",
    "@alcalzone/release-script-plugin-manual-review": "^5.2.0",
    "@iobroker/adapter-dev": "^1.5.0",
    "@iobroker/dev-server": "^0.8.0",
    "@iobroker/eslint-config": "^2.3.4",
    "@iobroker/testing": "^6.3.1",
    "@tsconfig/node22": "^22.0.6",
    "@types/iobroker": "npm:@iobroker/types@^7.2.2",
    "@types/node": "^22.20.5",
    "typescript": "~5.9.3"
  },
  "main": "build/main.js",
  "files": [
    "admin{,/!(src)/**}/!(tsconfig|tsconfig.*|.eslintrc).{json,json5}",
    "admin{,/!(src)/**}/*.{html,css,png,svg,jpg,js}",
    "build/",
    "!build/**/*.test.*",
    "www/",
    "docs/",
    "docker-compose.yaml",
    "io-package.json",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:test": "tsc -p tsconfig.json",
    "test:js": "npm run build:test && mocha --config test/mocharc.custom.json \"build/**/*.test.js\"",
    "test:package": "mocha test/package --exit",
    "test:integration": "mocha test/integration --exit",
    "test": "npm run test:js && npm run test:package",
    "check": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint -c eslint.config.mjs .",
    "translate": "translate-adapter",
    "dev-server": "dev-server",
    "release": "release-script"
  },
  "bugs": {
    "url": "https://github.com/seaspotter/ioBroker.victoriametrics/issues"
  },
  "readmeFilename": "README.md"
}
