{
    // Root tsconfig: type checking for editors/lint/tests (also emits the compiled tests to build/)
    // https://github.com/tsconfig/bases#node-22-tsconfigjson
    "extends": "@tsconfig/node22/tsconfig.json",
    "compilerOptions": {
        "outDir": "./build/",
        "rootDir": "./src/",
        "sourceMap": true,
        "skipLibCheck": true,
        "noEmitOnError": true,
        "resolveJsonModule": true,
        "useUnknownInCatchVariables": false,
        "types": ["node", "mocha", "chai"]
    },
    "include": ["src/**/*.ts", "src/**/*.d.ts"],
    "exclude": ["build/**", "node_modules/**", "widgets/**"]
}
