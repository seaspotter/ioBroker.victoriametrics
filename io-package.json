        "tier": 3,
        "mode": "daemon",
        "type": "storage",
        "compact": true,
        "connectionType": "local",
        "dataSource": "push",
        "messagebox": true,
        "getHistory": true,
        "adminUI": {
            "config": "json",
            "custom": "json"
        },
        "adminTab": {
            "link": "%protocol%://%host%:%port%/vmui/",
            "name": {
                "en": "VictoriaMetrics",
                "de": "VictoriaMetrics"
            },
            "singleton": true
        },
        "supportCustoms": true,
        "encryptedNative": ["password"],
        "protectedNative": ["password"],
        "dependencies": [
            {
                "js-controller": ">=6.0.11"
            }
        ],
        "globalDependencies": [
            {
                "admin": ">=7.0.23"
            }
        ]
    },
    "native": {
        "protocol": "http",
        "host": "",
        "port": 8428,
        "useAuth": false,
        "username": "",
        "password": "",
        "requestTimeout": 5000,
        "writeInterval": 10,
        "bufferMaxSize": 1000,
        "defaultRound": "",
        "defaultChangesMinDelta": "",
        "defaultDebounceTime": "",
        "defaultBlockTime": "",
        "defaultIgnoreBelowNumber": "",
        "defaultIgnoreAboveNumber": "",
        "defaultIgnoreZero": false,
        "defaultChangesOnly": false,
        "defaultChangesRelogInterval": ""
    },
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "role": "indicator.connected",
                "name": "Device or service connected",
                "type": "boolean",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        },
        {
            "_id": "info.retention",
            "type": "state",
            "common": {
                "role": "value",
                "name": {
                    "en": "VictoriaMetrics retention (read-only)",
                    "de": "VictoriaMetrics-Retention (nur lesend)"
                },
                "type": "string",
                "read": true,
                "write": false,
                "def": ""
            },
            "native": {}
        },
        {
            "_id": "cache",
            "type": "meta",
            "common": {
                "name": "Puffer-Cache",
                "type": "meta.folder"
            },
            "native": {}
        }
    ]
}