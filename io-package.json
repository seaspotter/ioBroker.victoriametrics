        "extIcon": "https://raw.githubusercontent.com/seaspotter/iobroker.victoriametrics/main/admin/victoriametrics.png",
        "readme": "https://github.com/seaspotter/iobroker.victoriametrics/blob/main/README.md",
        "loglevel": "info",
        "tier": 3,
        "mode": "daemon",
        "type": "storage",
        "compact": true,
        "connectionType": "local",
        "dataSource": "push",
        "messagebox": true,
        "adminUI": {
            "config": "json",
            "custom": "json"
        },
        "supportCustoms": true,
        "encryptedNative": ["password"],
        "protectedNative": ["password"],
        "dependencies": [
            {
                "js-controller": ">=6.0.11"
            }
        ],
        "globalDependencies": [
            {
                "admin": ">=7.0.23"
            }
        ]
    },
    "native": {
        "protocol": "http",
        "host": "",
        "port": 8428,
        "useAuth": false,
        "username": "",
        "password": "",
        "requestTimeout": 5000,
        "writeInterval": 10,
        "bufferMaxSize": 1000
    },
    "objects": [],
    "instanceObjects": [
        {
            "_id": "info",
            "type": "channel",
            "common": {
                "name": "Information"
            },
            "native": {}
        },
        {
            "_id": "info.connection",
            "type": "state",
            "common": {
                "role": "indicator.connected",
                "name": "Device or service connected",
                "type": "boolean",
                "read": true,
                "write": false,
                "def": false
            },
            "native": {}
        },
        {
            "_id": "cache",
            "type": "meta",
            "common": {
                "name": "Puffer-Cache",
                "type": "meta.folder"
            },
            "native": {}
        }
    ]
}