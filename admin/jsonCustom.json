{
    "i18n": true,
    "type": "panel",
    "items": {
        "debounceTime": {
            "type": "number",
            "label": "Entprellzeit (ms, optional)",
            "help": "Protokolliert den Wert erst, wenn er für die angegebene Zeit unverändert bleibt. Leer lassen für sofortiges Schreiben.",
            "hidden": "!data.enabled",
            "newLine": true,
            "min": 0,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4,
            "defaultFunc": "instanceObj.native.defaultDebounceTime"
        },
        "blockTime": {
            "type": "number",
            "label": "Blockzeit (ms, optional)",
            "help": "Ignoriert neue Werte für die angegebene Zeit nach dem zuletzt geschriebenen Wert.",
            "hidden": "!data.enabled",
            "min": 0,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4,
            "defaultFunc": "instanceObj.native.defaultBlockTime"
        },
        "ignoreBelowNumber": {
            "type": "number",
            "label": "Ignoriere Werte kleiner als (optional)",
            "hidden": "!data.enabled",
            "newLine": true,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4,
            "defaultFunc": "instanceObj.native.defaultIgnoreBelowNumber"
        },
        "ignoreAboveNumber": {
            "type": "number",
            "label": "Ignoriere Werte größer als (optional)",
            "hidden": "!data.enabled",
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4,
            "defaultFunc": "instanceObj.native.defaultIgnoreAboveNumber"
        },
        "ignoreZero": {
            "type": "checkbox",
            "label": "Ignoriere Nullwerte (0)",
            "hidden": "!data.enabled",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 4,
            "xl": 4,
            "defaultFunc": "instanceObj.native.defaultIgnoreZero"
        },
        "aliasId": {
            "type": "text",
            "label": "Metrik-Name (optional)",
            "help": "Überschreibt die automatisch aus der Objekt-ID abgeleitete Metrik (__name__). Leer lassen für Standardableitung.",
            "hidden": "!data.enabled",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 8,
            "lg": 8,
            "xl": 8
        },
        "round": {
            "type": "number",
            "label": "Runden auf Nachkommastellen (optional)",
            "help": "Rundet den Wert vor dem Schreiben auf die angegebene Anzahl Nachkommastellen. Leer lassen für keine Rundung.",
            "hidden": "!data.enabled",
            "newLine": true,
            "min": 0,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4,
            "defaultFunc": "instanceObj.native.defaultRound"
        },
        "changesMinDelta": {
            "type": "number",
            "label": "Minimale Änderung (optional)",
            "help": "Werte, die sich vom zuletzt geschriebenen Wert um weniger als diesen Betrag unterscheiden, werden nicht geschrieben. Leer lassen für keine Filterung.",
            "hidden": "!data.enabled",
            "min": 0,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4,
            "defaultFunc": "instanceObj.native.defaultChangesMinDelta"
        },
        "changesOnly": {
            "type": "checkbox",
            "label": "Nur Änderungen aufzeichnen",
            "help": "Schreibt einen Wert nur, wenn er sich vom zuletzt geschriebenen Wert unterscheidet.",
            "hidden": "!data.enabled",
            "newLine": true,
            "xs": 12,
            "sm": 12,
            "md": 4,
            "lg": 4,
            "xl": 4,
            "defaultFunc": "instanceObj.native.defaultChangesOnly"
        },
        "changesRelogInterval": {
            "type": "number",
            "label": "Relog-Intervall (ms, optional)",
            "help": "Schreibt einen unveränderten Wert spätestens nach dieser Zeit erneut, damit im Chart keine Lücken entstehen. Nur wirksam bei aktiviertem 'Nur Änderungen aufzeichnen'.",
            "hidden": "!data.enabled || !data.changesOnly",
            "min": 0,
            "xs": 12,
            "sm": 6,
            "md": 4,
            "lg": 4,
            "xl": 4,
            "defaultFunc": "instanceObj.native.defaultChangesRelogInterval"
        }
    }
}
