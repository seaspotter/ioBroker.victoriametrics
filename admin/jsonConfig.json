{
    "i18n": true,
    "type": "tabs",
    "items": {
        "connectionTab": {
            "type": "panel",
            "label": "Verbindung",
            "items": {
                "protocol": {
                    "type": "select",
                    "label": "Protokoll",
                    "options": [
                        { "value": "http", "label": "http" },
                        { "value": "https", "label": "https" }
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 2
                },
                "host": {
                    "type": "text",
                    "label": "Host / IP-Adresse",
                    "help": "Hostname oder IP-Adresse der VictoriaMetrics-Instanz, ohne Protokoll",
                    "xs": 12,
                    "sm": 6,
                    "md": 5,
                    "lg": 4
                },
                "port": {
                    "type": "number",
                    "label": "Port",
                    "min": 1,
                    "max": 65535,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                },
                "useAuth": {
                    "type": "checkbox",
                    "label": "Basic-Auth verwenden",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3
                },
                "username": {
                    "type": "text",
                    "label": "Benutzername",
                    "hidden": "!data.useAuth",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                },
                "password": {
                    "type": "password",
                    "label": "Passwort",
                    "hidden": "!data.useAuth",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                },
                "requestTimeout": {
                    "type": "number",
                    "label": "Timeout (ms)",
                    "min": 100,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                },
                "testConnectionDivider": {
                    "type": "divider",
                    "newLine": true
                },
                "testConnection": {
                    "type": "sendTo",
                    "command": "testConnection",
                    "jsonData": "{\"config\": {\"protocol\": \"${data.protocol}\", \"host\": \"${data.host}\", \"port\": ${Number(data.port) || 0}, \"useAuth\": ${!!data.useAuth}, \"username\": \"${data.username}\", \"password\": \"${encodeURIComponent(data.password || '')}\", \"requestTimeout\": ${Number(data.requestTimeout) || 5000}}}",
                    "label": "Verbindung testen",
                    "variant": "contained",
                    "color": "primary",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "error": {
                        "connect timeout": "Zeitüberschreitung bei der Verbindung"
                    }
                }
            }
        },
        "writeTab": {
            "type": "panel",
            "label": "Schreibverhalten",
            "items": {
                "writeInterval": {
                    "type": "number",
                    "label": "Schreibintervall (Sekunden)",
                    "help": "Wie oft gepufferte Werte gesammelt an VictoriaMetrics gesendet werden",
                    "min": 1,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                },
                "bufferMaxSize": {
                    "type": "number",
                    "label": "Max. Puffergröße (Punkte)",
                    "help": "Löst bei Erreichen einen sofortigen Schreibvorgang aus, unabhängig vom Schreibintervall",
                    "min": 1,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3
                }
            }
        },
        "defaultsTab": {
            "type": "panel",
            "label": "Standardwerte",
            "items": {
                "defaultsInfo": {
                    "type": "staticText",
                    "text": "Gelten für alle Datenpunkte, die im Historie-Tab kein eigenes Feld gesetzt haben.",
                    "newLine": true
                },
                "defaultDebounceTime": {
                    "type": "number",
                    "label": "Entprellzeit (ms, optional)",
                    "min": 0,
                    "newLine": true,
                    "sm": 6,
                    "md": 4
                },
                "defaultBlockTime": {
                    "type": "number",
                    "label": "Blockzeit (ms, optional)",
                    "min": 0,
                    "sm": 6,
                    "md": 4
                },
                "defaultIgnoreBelowNumber": {
                    "type": "number",
                    "label": "Ignoriere Werte kleiner als (optional)",
                    "newLine": true,
                    "sm": 6,
                    "md": 4
                },
                "defaultIgnoreAboveNumber": {
                    "type": "number",
                    "label": "Ignoriere Werte größer als (optional)",
                    "sm": 6,
                    "md": 4
                },
                "defaultIgnoreZero": {
                    "type": "checkbox",
                    "label": "Ignoriere Nullwerte (0)",
                    "newLine": true
                },
                "defaultRound": {
                    "type": "number",
                    "label": "Runden auf Nachkommastellen (optional)",
                    "min": 0,
                    "newLine": true,
                    "sm": 6,
                    "md": 4
                },
                "defaultChangesMinDelta": {
                    "type": "number",
                    "label": "Minimale Änderung (optional)",
                    "min": 0,
                    "sm": 6,
                    "md": 4
                }
            }
        }
    }
}
