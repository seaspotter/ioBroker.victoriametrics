{
    "i18n": true,
    "type": "tabs",
    "items": {
        "connectionTab": {
            "type": "panel",
            "label": "Verbindung",
            "items": {
                "dockerVictoria.enabled": {
                    "type": "checkDocker",
                    "label": "Selbst gehostetes VictoriaMetrics in Docker verwenden",
                    "help": "docker_explanation",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "protocol": {
                    "type": "select",
                    "label": "Protokoll",
                    "options": [
                        {
                            "value": "http",
                            "label": "http"
                        },
                        {
                            "value": "https",
                            "label": "https"
                        }
                    ],
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 3,
                    "lg": 2,
                    "xl": 2,
                    "hidden": "!!data.dockerVictoria?.enabled"
                },
                "host": {
                    "type": "text",
                    "label": "Host / IP-Adresse",
                    "help": "Hostname oder IP-Adresse der VictoriaMetrics-Instanz, ohne Protokoll",
                    "xs": 12,
                    "sm": 6,
                    "md": 5,
                    "lg": 4,
                    "xl": 4,
                    "hidden": "!!data.dockerVictoria?.enabled"
                },
                "port": {
                    "type": "number",
                    "label": "Port",
                    "min": 1,
                    "max": 65535,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3,
                    "hidden": "!!data.dockerVictoria?.enabled"
                },
                "useAuth": {
                    "type": "checkbox",
                    "label": "Basic-Auth verwenden",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3,
                    "hidden": "!!data.dockerVictoria?.enabled"
                },
                "username": {
                    "type": "text",
                    "label": "Benutzername",
                    "hidden": "!data.useAuth || !!data.dockerVictoria?.enabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "password": {
                    "type": "password",
                    "label": "Passwort",
                    "hidden": "!data.useAuth || !!data.dockerVictoria?.enabled",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "requestTimeout": {
                    "type": "number",
                    "label": "Timeout (ms)",
                    "min": 100,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "testConnectionDivider": {
                    "type": "divider",
                    "newLine": true,
                    "hidden": "!!data.dockerVictoria?.enabled"
                },
                "testConnection": {
                    "type": "sendTo",
                    "command": "testConnection",
                    "jsonData": "{\"config\": {\"protocol\": \"${data.protocol}\", \"host\": \"${data.host}\", \"port\": ${Number(data.port) || 0}, \"useAuth\": ${!!data.useAuth}, \"username\": \"${data.username}\", \"password\": \"${encodeURIComponent(data.password || '')}\", \"requestTimeout\": ${Number(data.requestTimeout) || 5000}}}",
                    "label": "Verbindung testen",
                    "variant": "contained",
                    "color": "primary",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3,
                    "error": {
                        "connect timeout": "Zeitüberschreitung bei der Verbindung"
                    },
                    "result": {
                        "ok": "Verbindung erfolgreich (Retention: %s)"
                    },
                    "hidden": "!!data.dockerVictoria?.enabled"
                }
            }
        },
        "dockerTab": {
            "type": "panel",
            "label": "VictoriaMetrics Docker",
            "hidden": "!data.dockerVictoria?.enabled",
            "items": {
                "dockerVictoria.bind": {
                    "newLine": true,
                    "listenOnAllPorts": true,
                    "type": "ip",
                    "label": "Container auf IP starten",
                    "help": "127.0.0.1 = nur auf diesem Rechner erreichbar. Nur in vertrauenswürdigen Netzen auf 0.0.0.0 oder eine andere IP ändern: VictoriaMetrics hat hier keine Zugangsbeschränkung.",
                    "xs": 12,
                    "sm": 12,
                    "md": 8,
                    "lg": 8,
                    "xl": 8
                },
                "dockerVictoria.port": {
                    "type": "port",
                    "label": "Port",
                    "help": "Port, unter dem der Container auf diesem Rechner erreichbar ist",
                    "default": 8428,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 4,
                    "xl": 4
                },
                "dockerVictoria.retentionPeriod": {
                    "newLine": true,
                    "type": "text",
                    "label": "Aufbewahrungsdauer (Retention)",
                    "help": "Zahl = Monate, oder mit Einheit h, d, w, y (z. B. 12, 90d, 100y). Eine Änderung erstellt den Container neu; die Daten bleiben erhalten.",
                    "default": "100y",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "dockerVictoria.stopIfInstanceStopped": {
                    "newLine": true,
                    "type": "checkbox",
                    "label": "Container stoppen, wenn die Instanz stoppt",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                },
                "dockerVictoria.autoImageUpdate": {
                    "type": "checkbox",
                    "label": "Docker-Image automatisch aktualisieren",
                    "help": "Wenn aktiviert, wird beim Start des Adapters das neueste Docker-Image geladen.",
                    "xs": 12,
                    "sm": 12,
                    "md": 6,
                    "lg": 6,
                    "xl": 6
                }
            }
        },
        "writeTab": {
            "type": "panel",
            "label": "Schreibverhalten",
            "items": {
                "writeInterval": {
                    "type": "number",
                    "label": "Schreibintervall (Sekunden)",
                    "help": "Wie oft gepufferte Werte gesammelt an VictoriaMetrics gesendet werden",
                    "min": 1,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "bufferMaxSize": {
                    "type": "number",
                    "label": "Max. Puffergröße (Punkte)",
                    "help": "Löst bei Erreichen einen sofortigen Schreibvorgang aus, unabhängig vom Schreibintervall",
                    "min": 1,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        },
        "defaultsTab": {
            "type": "panel",
            "label": "Standardwerte",
            "items": {
                "defaultsInfo": {
                    "type": "staticText",
                    "text": "Gelten für alle Datenpunkte, die im Historie-Tab kein eigenes Feld gesetzt haben.",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 12,
                    "lg": 12,
                    "xl": 12
                },
                "defaultDebounceTime": {
                    "type": "number",
                    "label": "Entprellzeit (ms, optional)",
                    "min": 0,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "defaultBlockTime": {
                    "type": "number",
                    "label": "Blockzeit (ms, optional)",
                    "min": 0,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "defaultIgnoreBelowNumber": {
                    "type": "number",
                    "label": "Ignoriere Werte kleiner als (optional)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "defaultIgnoreAboveNumber": {
                    "type": "number",
                    "label": "Ignoriere Werte größer als (optional)",
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "defaultIgnoreZero": {
                    "type": "checkbox",
                    "label": "Ignoriere Nullwerte (0)",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "defaultRound": {
                    "type": "number",
                    "label": "Runden auf Nachkommastellen (optional)",
                    "min": 0,
                    "newLine": true,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "defaultChangesMinDelta": {
                    "type": "number",
                    "label": "Minimale Änderung (optional)",
                    "min": 0,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "defaultChangesOnly": {
                    "type": "checkbox",
                    "label": "Nur Änderungen aufzeichnen",
                    "newLine": true,
                    "xs": 12,
                    "sm": 12,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                },
                "defaultChangesRelogInterval": {
                    "type": "number",
                    "label": "Relog-Intervall (ms, optional)",
                    "min": 0,
                    "xs": 12,
                    "sm": 6,
                    "md": 4,
                    "lg": 3,
                    "xl": 3
                }
            }
        }
    }
}
